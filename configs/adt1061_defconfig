CONFIG_ARM=y
CONFIG_ARCH_SPRD=y
CONFIG_TARGET_UMS512_1H10=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_INIT_SP_RELATIVE=y
CONFIG_SYS_MALLOC_F_LEN=0x4000
CONFIG_NR_DRAM_BANKS=1
# CONFIG_PSCI_RESET is not set
CONFIG_DEFAULT_DEVICE_TREE="adt1061"
CONFIG_OF_LIBFDT_OVERLAY=y
# Lets ft_board_setup() (board/spreadtrum/ums512_1h10/ums512_1h10.c,
# hwfeature.c) write the chip-variant/revision /hwfeature node into
# the kernel's devicetree, same as stock U-Boot does.
CONFIG_OF_BOARD_SETUP=y
CONFIG_CLK=y
CONFIG_DM_SERIAL=y
CONFIG_SPRD_SERIAL=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SPRD_ADI_SPI=y
CONFIG_PMIC_SC2730=y
CONFIG_DM_PMIC=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_SC2730=y
# SC2730 PMIC watchdog (drivers/watchdog/wdt-sc27xx.c): CONFIG_WATCHDOG
# makes U-Boot itself service it periodically via the cyclic framework,
# so a genuine hang during the bootloader stage still ends in a reset
# rather than a dead board; CONFIG_WATCHDOG_AUTOSTART (Kconfig default
# "y" once CONFIG_WDT is set) starts it automatically at boot.
CONFIG_WDT=y
CONFIG_WDT_SC27XX=y
CONFIG_WATCHDOG=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_SPRD=y
CONFIG_MISC=y
CONFIG_BQ2560X_CHARGER=y
CONFIG_SPRD_FGU=y
CONFIG_SPRD_VIBRATOR=y
CONFIG_DM_GPIO=y
CONFIG_SPRD_GPIO=y
CONFIG_VIDEO=y
CONFIG_VIDEO_SPRD=y
CONFIG_CMD_BMP=y
CONFIG_SPLASH_SCREEN=y
CONFIG_SPLASH_SOURCE=y
CONFIG_HIDE_LOGO_VERSION=y
CONFIG_BMP_16BPP=y
CONFIG_BMP_24BPP=y
CONFIG_BMP_32BPP=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="Unisoc"
CONFIG_USB_GADGET_VENDOR_NUM=0x1782
CONFIG_USB_GADGET_PRODUCT_NUM=0x4d00
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_SPRD=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x90000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_FASTBOOT_MMC_USER_SUPPORT=y
# "poweroff": arch/arm/mach-sprd/cpu.c's do_poweroff(), SC2730 PMIC
# hardware power-down sequencer - see drivers/power/pmic/pmic_sc2730.c's
# sc2730_pmic_poweroff(). "reset" (CONFIG_CMD_RESET) needs no entry
# here - it's always built in, and already works via reset_cpu()'s own
# SC2730 watchdog-forced reset (see arch/arm/mach-sprd/cpu.c).
CONFIG_CMD_POWEROFF=y
CONFIG_CMD_FASTBOOT=y
# "ums 0 mmc 0" exposes the whole eMMC as a plain USB mass-storage disk
# to the host PC (dd/flash-tool friendly, often faster than repeated
# "fastboot flash" calls for bulk writes) - rides on the same USB
# gadget stack fastboot already uses above.
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_CMD_MMC=y
CONFIG_PARTITIONS=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC_WRITE=y
CONFIG_CMD_PART=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
# UEFI support. EFI_LOADER/CMD_BOOTEFI_BOOTMGR already default to "y" on
# this arch (armv8) via their own Kconfig defaults, so this is only here
# to make the choice explicit and future-proof against a default
# changing upstream. Measured cost on this board: ~116KB (~18%) added to
# u-boot-nodtb.bin (654400 -> 772952 bytes) - not excessive against the
# signed image's current ~800KB total, so kept on.
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
CONFIG_CMD_BOOTI=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_ABOOTIMG=y
CONFIG_CMD_ADTIMG=y
CONFIG_CMD_BCB=y
CONFIG_DM_RTC=y
CONFIG_RTC_SC27XX=y
CONFIG_HUSH_PARSER=y
CONFIG_SYS_PROMPT="adt1061=> "
CONFIG_AUTOBOOT=y
CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y
# The ${bootpart} partition's Android Boot Image (header v2) carries
# its DTB already fully merged on the kernel-build host (the
# "adt1061-overlay.dtso" fragment's faceid-mem/vdsp-mem reserved
# regions and ion heaps are now baked directly into adt1061.dts
# itself, compiled as one flat tree) - so there is no "dtbo" GPT
# partition and no runtime fdt_overlay_apply() step any more. Just
# pull the embedded DTB (the real, full production device tree, not
# u-boot's own minimal bring-up one) out of the boot image and hand
# it straight to bootm.
#
# bootm's 2nd (ramdisk) argument is the loaded boot.img's own address
# (0x90000000), NOT "-". boot_get_ramdisk() (boot/image-board.c)
# treats a literal "-" as "skip the ramdisk entirely" - not "auto
# detect" - so every prior boot was handing the kernel no initrd at
# all despite "root=/dev/ram0" in the cmdline (confirmed on real
# hardware: kernel boots cleanly through driver/subsystem init, then
# has nothing to mount as root/exec as init). Pointing this argument
# at the boot.img address makes select_ramdisk() recognize the
# IMAGE_FORMAT_ANDROID header there and call android_image_get_ramdisk(),
# which pulls the ramdisk from the header's own ramdisk_addr/
# ramdisk_size fields - i.e. exactly the address mkbootimg computed
# from its --base/--ramdisk_offset, no hand-picked address needed here.
#
# board_late_init() (board/spreadtrum/ums512_1h10/ums512_1h10.c) may
# set, before this command ever runs:
#   - force_fastboot   : volume-down held at boot, or BCB command was
#                         "boot-fastboot"/"bootonce-bootloader" -> go
#                         straight to fastboot, skip Android entirely.
#   - bootpart          : BCB command "boot-recovery" sets this to
#                         "recovery" instead of the default "boot".
#                         Should this device lack such a GPT
#                         partition, the "part start" lookup below
#                         simply fails and the whole chain falls
#                         through to its own "fastboot usb 0"
#                         fallback - safe either way.
#   - extra_bootargs    : extra androidboot.bootreason=... etc, folded
#                         into bootargs right before bootm.
#
# ROOT CAUSE FOUND (replaces the earlier temporary "md.l 0x327e008c"
# register-read diagnostic, now removed - its job is done): real-hardware
# boot logs proved the sharkl5pro_clk/isppll-gate "synchronous external
# abort" panic is NOT a static TrustZone/firewall lock (U-Boot's own read
# of the same register, and even the kernel's own diagnostic reads at
# various points, always came back clean). The actual trigger is the
# kernel's built-in late_initcall_sync housekeeping, which runs ~50ms
# *before* any of our modules load (confirmed: "clk: Disabling unused
# clocks" / "PM: genpd: Disabling unused power domains" at ~2.36s, vs.
# "sprd_clk: loading out-of-tree module..." at ~2.42s, vs. the abort at
# ~2.44s):
#   clk: Disabling unused clocks
#   PM: genpd: Disabling unused power domains
# At that point sharkl5pro_clk.ko/sprd_clk.ko have not been insmod'd yet
# (they're loaded later from userspace /init, long after late_initcall),
# so the generic clk/genpd core sees the AP/AON-APB bus-gate clock behind
# PMU_APB as having no registered consumer and powers it down as
# "unused". When our OOT modules finally load and sprd_gate_is_enabled()
# does its first regmap_read() of REG_PMU_APB_ISPPLL_REL_CFG, the whole
# PMU_APB bus segment is unclocked and the MMIO read bus-errors. This
# reproduced identically regardless of module load order (tested with
# sharkl5pro_clk moved both to load last and to load first, right after
# sprd_clk) - confirming it is a *timing* issue (OOT module vs.
# late_initcall_sync), not an *ordering* issue between OOT modules.
#
# Fix: pass the standard kernel parameters "clk_ignore_unused" and
# "pd_ignore_unused" so clk_disable_unused()/genpd's unused-domain sweep
# never runs at all, leaving every clock/power-domain the
# bootloader/firmware left on untouched until a real driver claims and
# manages it - exactly what's needed when the real consumer is a
# loadable module that only arrives well after late_initcall. Prepended
# to bootargs here (not baked into the boot image), so it reaches the
# kernel regardless of what the image's own embedded cmdline carries -
# see boot/image-android.c's android_image_get_kernel(), which puts the
# env "bootargs" value *before* the image's own cmdline when building the
# final kernel command line.
# "hwfeature_bootargs" (androidboot.auto.efuse=/auto.chipid=/
# lwfq.type=, see board/spreadtrum/ums512_1h10/hwfeature.c) is set by
# board_late_init() every boot, before this command ever runs - folded
# in here alongside "extra_bootargs" so both always make it onto the
# kernel cmdline regardless of which BOOTCOMMAND branch is taken.
CONFIG_BOOTCOMMAND="if test -n \"${force_fastboot}\"; then fastboot usb 0; fi; if test -z \"${bootpart}\"; then setenv bootpart boot; fi; setenv bootargs \"clk_ignore_unused pd_ignore_unused ${hwfeature_bootargs} ${extra_bootargs}\"; mmc dev 0 && part start mmc 0 ${bootpart} boot_start && part size mmc 0 ${bootpart} boot_size && mmc read 0x90000000 ${boot_start} ${boot_size} && abootimg addr 0x90000000 && abootimg get dtb --index=0 dtb0_start dtb0_size && cp.b ${dtb0_start} 0xa2000000 ${dtb0_size} && bootm 0x90000000 0x90000000 0xa2000000; echo booting ${bootpart} partition failed, entering fastboot; fastboot usb 0"
CONFIG_LOG=y
CONFIG_LOGLEVEL=8
CONFIG_LOG_DEFAULT_LEVEL=8
CONFIG_LOG_CONSOLE=y
# Boot-time profiling: prints a per-stage timing breakdown just before
# handing off to the kernel (see boot/Kconfig's BOOTSTAGE_REPORT help
# for a sample of what the report looks like). Negligible size/runtime
# cost, useful for spotting slow stages.
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_REPORT=y
